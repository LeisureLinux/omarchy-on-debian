#!/bin/bash

# omarchy:summary=Returns true if any of the named packages are missing from the system (or false if they're all there).
# omarchy:args=<packages...>

# This is the omarchy-on-debian port: replaces `pacman -Q` with
# `dpkg-query -W`. The check semantics match: returns 0 if any
# package is not installed, 1 if they all are.

for pkg in "$@"; do
  # dpkg-query exits non-zero and prints nothing for unknown packages,
  # but for known-but-not-installed configurations it also exits
  # non-zero. We only want to trust the status string itself: a healthy
  # install looks like `install ok installed` on a single line.
  if ! dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q '^install ok installed$'; then
    exit 0
  fi
done

exit 1
