#!/usr/bin/env bash
# omarchy-wallpaper-rotate — control wpaperd rotation
#
# Subcommands:
#   status               show daemon status + current wallpaper per output
#   next                 advance to the next wallpaper on every output
#   prev                 go back one wallpaper
#   pause                freeze rotation (kill -STOP wpaperd; resume with 'resume')
#   resume               unfreeze rotation (kill -CONT wpaperd)
#   reload               reload after editing wallpaper.toml
#   set-folder PATH      swap the wallpaper folder (first [output.*]) and reload
#   init                 seed ~/.config/wpaperd/wallpaper.toml on first run
#
# wpaperd only exposes get/next/previous/reload over its Unix socket —
# pause/resume are implemented locally via SIGSTOP/SIGCONT on the daemon.
set -euo pipefail

WPAPERD_BIN="${WPAPERD_BIN:-$(command -v wpaperd || true)}"
WPAPERCTL_BIN="${WPAPERCTL_BIN:-$(command -v wpaperctl || true)}"

usage() {
  sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-1}"
}

cmd="${1:-status}"
shift || true

case "$cmd" in
  -h|--help|help) usage 0 ;;
  status)
    if [[ -n "${WPAPERD_BIN}" ]] && pgrep -x wpaperd >/dev/null; then
      echo "wpaperd: running (pid $(pgrep -x wpaperd))"
      echo
      if [[ -n "${WPAPERCTL_BIN}" ]]; then
        wpaperctl all-wallpapers 2>&1 || true
      fi
    else
      echo "wpaperd: not running"
      echo "  start with: systemctl --user start wpaperd.service"
      echo "  or live:    $WPAPERD_BIN"
      exit 1
    fi
    ;;

  next)
    if [[ -n "${WPAPERCTL_BIN}" ]]; then exec wpaperctl next-wallpaper
    else echo "wpaperctl not found" >&2; exit 1; fi
    ;;

  prev)
    if [[ -n "${WPAPERCTL_BIN}" ]]; then exec wpaperctl previous-wallpaper
    else echo "wpaperctl not found" >&2; exit 1; fi
    ;;

  reload)
    if [[ -n "${WPAPERCTL_BIN}" ]]; then exec wpaperctl reload-wallpaper
    else
      [[ -n "${WPAPERD_BIN}" ]] && pgrep -x wpaperd >/dev/null && pkill -HUP -x wpaperd
      echo "reload → SIGHUP sent to wpaperd"
    fi
    ;;

  pause)
    pgrep -x wpaperd >/dev/null || { echo "wpaperd not running" >&2; exit 1; }
    pkill -STOP -x wpaperd
    echo "wpaperd paused (SIGSTOP). Resume with: omarchy-wallpaper-rotate resume"
    ;;

  resume)
    pgrep -x wpaperd >/dev/null || { echo "wpaperd not running" >&2; exit 1; }
    pkill -CONT -x wpaperd
    echo "wpaperd resumed"
    ;;

  set-folder)
    folder="${1:?usage: omarchy-wallpaper-rotate set-folder PATH}"
    [[ -d "$folder" ]] || { echo "not a directory: $folder" >&2; exit 1; }
    cfg="${XDG_CONFIG_HOME:-$HOME/.config}/wpaperd/wallpaper.toml"
    [[ -f "$cfg" ]] || { echo "no $cfg yet — run 'omarchy-wallpaper-rotate init' first" >&2; exit 1; }
    python3 - "$cfg" "$folder" <<'PYEOF'
import re, sys
p, folder = sys.argv[1], sys.argv[2]
src = open(p).read()
new = re.sub(r'(?m)^(\s*path\s*=\s*)"[^"]*"', rf'\1"{folder}"', src, count=1)
if new == src:
    sys.exit(f"no 'path = ...' line found in {p}")
open(p, 'w').write(new)
print(f"rewrote first path in {p} → {folder}")
PYEOF
    omarchy-wallpaper-rotate reload
    ;;

  init)
    cfg_dir="${XDG_CONFIG_HOME:-$HOME/.config}/wpaperd"
    cfg="${cfg_dir}/wallpaper.toml"
    if [[ -f "$cfg" ]]; then
      echo "exists: $cfg"
      echo "edit it manually, then run: omarchy-wallpaper-rotate reload"
      exit 0
    fi
    mkdir -p "$cfg_dir"
    cat > "$cfg" <<TOML
# wpaperd configuration — generated by omarchy-wallpaper-rotate init

[socket]
path = "/tmp/wpaperd.sock"

[output.DP-4]
path = "$HOME/Pictures/wallpapers"
duration = "15m"
transition_time = "1s"
transition_type = "fade"

[output.eDP-1]
path = "$HOME/Pictures/wallpapers"
duration = "15m"
transition_time = "1s"
transition_type = "fade"
TOML
    echo "wrote $cfg"
    echo "next: ensure $HOME/Pictures/wallpapers/ has at least one image,"
    echo "then run: systemctl --user enable --now wpaperd.service"
    ;;

  *)
    echo "unknown command: $cmd" >&2
    usage 1
    ;;
esac
